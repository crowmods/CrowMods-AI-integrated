NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
DATABASE_URL=postgresql://crowmods:CHANGE_ME@localhost:5432/crowmods_ai

# Auth / sessions
SESSION_TTL_MS=86400000
PASSWORD_RESET_TTL_MS=3600000
JWT_SECRET=change-me-in-production

# Uploads / quarantine storage
UPLOADS_DIR=
MAX_UPLOAD_BYTES=314572800

# Initial admin (provisioned on boot when both are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
